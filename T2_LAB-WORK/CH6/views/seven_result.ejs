<!DOCTYPE html>
<html>
<head>
    <style>
        table, th, td { border: 1px solid black; border-collapse: collapse; padding: 10px; }
    </style>
</head>
<body>
    <h2>Student Marksheet</h2>
    <table>
        <tr><th>Subject</th><th>Marks</th></tr>
        <tr><td>T1</td><td><%= t1 %></td></tr>
        <tr><td>T2</td><td><%= t2 %></td></tr>
        <tr><td>T3</td><td><%= t3 %></td></tr>
        <tr><td>T4</td><td><%= t4 %></td></tr>
        <tr style="background-color: #eee;">
            <td><strong>Total</strong></td>
            <td><strong><%= total %></strong></td>
        </tr>
    </table>

    <br>

    <% if (total >= 35) { %>
        <h2 style="color: green;">Result: PASS</h2>
    <% } else { %>
        <h2 style="color: red;">Result: FAIL</h2>
    <% } %>
</body>
</html>
