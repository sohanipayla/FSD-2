<!DOCTYPE html>
<html>
<head>
    <title>Contact Page</title>
</head>
<body>
    <h1>Contact Form</h1>

    <form action="/submit" method="POST">
        <!-- (i) Name Input -->
        <label>Name:</label>
        <input type="text" name="name" required>
        <br><br>

        <!-- (ii) Email Input -->
        <label>Email:</label>
        <input type="email" name="email" required>
        <br><br>

        <!-- (iii) Submit Button -->
        <button type="submit">Submit</button>
    </form>
</body>
</html>
